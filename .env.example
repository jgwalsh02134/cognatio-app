# Copy this file to .env and fill in your real key.
# .env is gitignored — it must NEVER be committed.

# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-replace-me

# Optional: override the default model (cheapest reasonable default is gpt-4o-mini).
# Other good choices: gpt-4o, o4-mini, o3-mini.
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# FamilySearch OAuth2 integration (optional)
# Register your app at https://www.familysearch.org/developers/
# ---------------------------------------------------------------------------

# OAuth2 client credentials from the FamilySearch Developer Console.
FAMILYSEARCH_CLIENT_ID=
FAMILYSEARCH_CLIENT_SECRET=

# The redirect URI registered with FamilySearch (must be an exact match).
# For Railway: https://your-app.up.railway.app/api/familysearch/callback
FAMILYSEARCH_REDIRECT_URI=https://your-domain.com/api/familysearch/callback

# "production" (default) or "integration" (FamilySearch sandbox).
# FAMILYSEARCH_ENV=production

# OAuth scopes to request (default: fhir).
# FAMILYSEARCH_SCOPES=fhir

# HMAC key for the OAuth state parameter (CSRF protection).
# Falls back to DATA_WRITE_PASSCODE if unset. Set a long random string here.
FAMILYSEARCH_STATE_SECRET=
