# Copy this file to .env and fill in your real key.
# .env is gitignored — it must NEVER be committed.

# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-replace-me

# Optional: override the default model (cheapest reasonable default is gpt-4o-mini).
# Other good choices: gpt-4o, o4-mini, o3-mini.
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# FamilySearch API (server-side only — tokens are NEVER exposed to the client)
# ---------------------------------------------------------------------------
# Obtain credentials at https://developers.familysearch.org
# Create an app, then generate a refresh token via the OAuth2 device-code or
# authorization-code flow for the family account that owns the tree.
#
# FAMILYSEARCH_CLIENT_ID=your-client-id
# FAMILYSEARCH_CLIENT_SECRET=your-client-secret
# FAMILYSEARCH_REFRESH_TOKEN=your-refresh-token
#
# Optional: set to "beta" to use apibeta.familysearch.org instead of the
# production API (useful for testing without affecting real records).
# FAMILYSEARCH_ENV=prod
